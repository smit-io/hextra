{
  "name": "Hextra - theme development",
  "dockerComposeFile": "docker-compose.yml",
  "service": "dev",
  "workspaceFolder": "/workspaces/hextra",
  "features": {
    "ghcr.io/devcontainers/features/hugo:1": {
      "extended": true,
      "version": "0.161.1"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    // Docker CLI against the host daemon (socket mounted in docker-compose.yml)
    // so `make ci*` can run act inside the container.
    // moby: false — the moby packages don't exist on Debian trixie (this
    // image's base); Docker's official CLI packages do.
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    },
    "ghcr.io/devcontainers-extra/features/act:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "mhutchie.git-graph",
        "esbenp.prettier-vscode",
        "tamasfe.even-better-toml",
        "budparr.language-hugo-vscode",
        "bradlc.vscode-tailwindcss",
        "austenc.tailwind-docs",
        "Zarifprogrammer.tailwind-snippets",
        "kamikillerto.vscode-colorize",
        "ecmel.vscode-html-css",
        "Zignd.html-css-class-completion"
      ]
    }
  },
  // docs/public is gitignored and will not exist on a fresh clone. Create it on
  // the host first, otherwise Docker creates it as root and the build cannot
  // write there.
  "initializeCommand": "mkdir -p docs/public",
  // The node_modules named volume (docker-compose.yml) is created empty and
  // root-owned, because nothing exists at that path in the image for Docker to
  // seed ownership from. Claim it for the container user before installing,
  // otherwise npm fails with EACCES on the first mkdir.
  //
  // Playwright browsers are not in the image and not in node_modules; they go
  // to ~/.cache/ms-playwright. Run unprivileged so that cache is owned by the
  // container user; --with-deps elevates on its own for the apt step only.
  // Chromium only: playwright.config.ts declares no projects.
  "postCreateCommand": "sudo chown -R \"$(id -u):$(id -g)\" node_modules && npm install && npx playwright install --with-deps chromium",
  // 1313 is the Hugo dev server, preview:8043 is the goStatic service.
  "forwardPorts": [1313, "preview:8043"]
}
